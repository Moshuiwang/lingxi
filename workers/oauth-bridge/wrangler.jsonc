{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lingxi-bot-test-oauth-bridge",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "biai.chunbai.com/oauth/*",
      "zone_name": "chunbai.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_BRIDGE",
        "class_name": "OAuthBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OAuthBridge"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  }
}
