# scripts/dev/remote_check.sh 的配置样例。
#
# 用法：复制成 <仓库根>/.dev-check/remote.env（该目录已在 .gitignore），按目标主机改值；
# 也可以直接用同名环境变量，环境变量优先于文件。换主机 = 再写一份，运行时用
# LINGXI_REMOTE_ENV_FILE=<路径> 指过去，代码零改动。
#
# 格式：每行 KEY=value，可带 export 前缀；值可用一对单 / 双引号包住（不处理转义）；
# 以 # 开头的整行是注释。只接受 LINGXI_REMOTE_* 变量。
#
# 真实主机名、登录用户、路径只放在这份私有文件里，不进仓库任何文件（含样例、文档、提交信息）。

# 连接命令整串（必填）。按空白切词、不解析引号；需要端口、跳板、密钥等复杂选项时
# 写进 ~/.ssh/config 用别名引用。这条命令必须能免交互连上（公钥或 Tailscale SSH）。
# 例：ssh gate-host   或   tailscale ssh user@gate-host
LINGXI_REMOTE_SSH="ssh gate-host"

# 远端检出目录（必填）。可以 ~/ 开头（在远端展开）。须是一个已经 git clone 好、
# 工作树干净的仓库检出：脚本每次把它 checkout --detach 到目标提交，脏了就拒绝。
LINGXI_REMOTE_WORKDIR="~/lingxi-gate"

# 远端一次性真库容器名（可选，默认 lingxi-remote-check-pg），透传给 check.sh 的
# LINGXI_DEV_CHECK_PG_NAME。跑完由 check.sh 自清，脚本结束时回读一次，残留即判失败。
LINGXI_REMOTE_PG_NAME=lingxi-remote-check-pg

# 提交怎么到远端（可选，默认 bundle）：
#   bundle  本机 git bundle 经同一条 SSH 送过去再 fetch。候选冻结后、推送 GitHub 之前
#           就能跑，不依赖远端能访问 GitHub；增量只含远端还没有的提交。
#   fetch   远端自己 git fetch origin <sha>，只适用于已推送的提交。
LINGXI_REMOTE_TRANSPORT=bundle

# 透传给 check.sh 的参数（可选，默认 full）。本脚本不替你加 --reuse-venv：默认每次
# 重建 venv 是 check.sh 防「本机多装了包」假绿的核验，要跳过就自己在这里显式写并承担
# 后果。不要加 --keep-db，残留容器检查会判红。
LINGXI_REMOTE_CHECK_ARGS=full

# 远端 check.sh 的最长运行秒数（可选，默认不限）。到点由远端 timeout 终止整个进程组，
# check.sh 的清理照常执行，本脚本按退出码 124 判失败。
# LINGXI_REMOTE_TIMEOUT_SECONDS=2400
