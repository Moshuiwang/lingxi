.env
.env.*
!.env.example

# 本地临时产品资料，不进入版本库
.tmp/

__pycache__/
*.py[cod]
.venv/
# scripts/dev/check.sh 按需建出的一次性虚拟环境缓存（Issue #236），运行时产物，
# 不是事实源——事实源是 .github/workflows/{ci,story}.yml，本目录随时可删重建。
.dev-check/
node_modules/
.claude/worktrees/

# Python 打包与构建产物：在仓库根目录跑 pip install 会生成它们，
# 一旦提交就会出现两份源码与陈旧的打包元数据。
build/
dist/
*.egg-info/

# 依赖只以 pyproject.toml 声明，CI 与受控环境用 pip 安装；本地 uv 锁文件不入库
uv.lock
