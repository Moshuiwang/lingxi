# db_backup_install.env —— scripts/ops/db_backup_install.sh 的输入样例（#896；来源 = #809 两形样例，已脱敏）。
# 用法：复制成与脚本同目录的 db_backup_install.env（root 0600），按主机事实填值。KEY=VALUE，不执行；只认 LINGXI_S31_*。
# 无秘密：只有路径、sha、标签；异机接收地址 REMOTE 只写进宿主生成的 db-backup.env（root 0600），任何输出只用标签。
# 预发 / 生产两形只差下面标了「两形差异」的行，脚本本体逐字相同。
#
# 四份来源副本放脚本同目录，从仓库同一提交复制：scripts/ops/db_backup.sh、deploy/monitoring-units/lingxi-db-backup.service、
# deploy/monitoring-units/lingxi-db-backup.timer、scripts/ops/host_health_alert.py。
# 下面四行必填：同一提交里对这四个文件 `sha256sum` 的输出（不填或不等，apply 拒绝且不做任何改动）。
# 回读判据（#886 第 2 处）：这四份是「输入副本」，装后在位 sha 须等于这里的值；db-backup.env 与巡检 drop-in 是脚本
# 「现场生成」的，sha 必然不同于本文件，只核 apply / monitor-enable 打印的 installed 或 already_in_place 值。
LINGXI_S31_SCRIPT_SHA=
LINGXI_S31_SERVICE_SHA=
LINGXI_S31_TIMER_SHA=
LINGXI_S31_MONITOR_SCRIPT_SHA=
LINGXI_S31_MONITOR_SCRIPT_DST=/opt/lingxi/scripts/host_health_alert.py
# 落位路径（缺省即 deploy/监控告警.md 十.2 的路径，写出来便于 dry 核对）
LINGXI_S31_SCRIPT_DST=/opt/lingxi/scripts/db_backup.sh
LINGXI_S31_UNIT_DIR=/etc/systemd/system
LINGXI_S31_ENV_DST=/opt/lingxi/monitoring/db-backup.env
LINGXI_S31_BACKUP_DIR=/var/lib/lingxi/backups
LINGXI_S31_STATUS_FILE=/var/lib/lingxi/db-backup-status.json
LINGXI_S31_BACKUP_ROOT=/root/lingxi-s31-backup
# 备份脚本输入（写进 db-backup.env 的 LINGXI_DB_BACKUP_*）
LINGXI_S31_CONTAINER=lingxi-db
LINGXI_S31_KEEP=14
# 异机副本（deploy/监控告警.md 十.2.1）。顺序：TRANSFER=none 先 apply + run-once 跑通本地三件 → probe-remote →
# ensure-remote-dir → 改 TRANSFER=scp 重跑 apply（db-backup.env 随之重写，sha 变化属预期）→ run-once 看 transfer.ok:true。
# 两形差异：接收方与标签。生产 → 预发主机（标签 biai-stage）；预发 → 研发机（标签自定，1–32 位字母数字 ._-）。
# REMOTE 形如 <接收账号>@<接收主机名>:~/lingxi-backups，按主机事实填入并去掉行首 #（脚本做形状校验，占位串本身会被拒绝）。
LINGXI_S31_TRANSFER=none
# LINGXI_S31_REMOTE=<接收账号>@<接收主机名>:~/lingxi-backups
LINGXI_S31_REMOTE_LABEL=offsite
# 宿主巡检 drop-in（monitor-enable）：从 systemctl cat lingxi-host-monitor.service 的最后一条非空 ExecStart= 派生，不假设原文
LINGXI_S31_MONITOR_UNIT=lingxi-host-monitor.service
LINGXI_S31_MONITOR_DROPIN=30-lingxi-db-checks.conf
LINGXI_S31_MON_MAX_AGE_HOURS=26
LINGXI_S31_MON_CONN_PERCENT=80
LINGXI_S31_MON_WAL_BYTES=2147483648
