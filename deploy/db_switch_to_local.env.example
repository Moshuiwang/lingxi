# db_switch_to_local.env —— scripts/ops/db_switch_to_local.sh 的输入样例（#896；来源 = #809 两形样例，已脱敏）。
# 用法：复制成与脚本同目录的 db_switch_to_local.env（root 0600），按主机事实填值。KEY=VALUE，不执行；只认 LINGXI_S30_*。
# 本文件不放任何秘密：来源连接串只从宿主 <config_root>/.env.<env>.migrate（或 LINGXI_S30_SOURCE_ENV_FILE）读，本地库口令由
# install-pg 现场生成进 /etc/lingxi/db/.env.db。预发 / 生产两形只差下面标了「两形差异」的行，脚本本体逐字相同。
#
# project / config_root / environment / docker 从宿主契约读，不在此重复；需要覆盖时才写
# LINGXI_S30_PROJECT / LINGXI_S30_CONFIG_ROOT。
# 两形差异 ①：宿主契约位置。生产缺省 /opt/lingxi/control/host-contract.json（不写本行）；预发在拉取代理目录：
# LINGXI_S30_HOST_CONTRACT=/opt/lingxi/release-pull/host-contract.json
# 两形差异 ②：env 后缀（stage | prod），与宿主 <config_root>/.env.<后缀>.* 一致。
LINGXI_S30_ENV_SUFFIX=stage
# compose 副本：缺省 = 脚本同目录的 compose.db.yaml（从仓库同一提交的 deploy/compose.db.yaml 复制）。
# 下一行必填：同一提交里 `sha256sum deploy/compose.db.yaml` 的输出（不填或不等，preflight 拒绝）。
LINGXI_S30_COMPOSE_SHA=
# 本地库：compose 项目 / 容器 / 回环端口 / 目录（缺省即下列值；预发与生产同名）
LINGXI_S30_DB_PROJECT=lingxi-db
LINGXI_S30_DB_CONTAINER=lingxi-db
LINGXI_S30_DB_HOST_PORT=5432
LINGXI_S30_DB_CONFIG_DIR=/etc/lingxi/db
LINGXI_S30_DB_INSTALL_DIR=/opt/lingxi/db
LINGXI_S30_DB_DATA_DIR=/var/lib/lingxi/pgdata
LINGXI_S30_WORK_ROOT=/var/lib/lingxi/migrate
LINGXI_S30_BACKUP_ROOT=/root/lingxi-s30-backup
LINGXI_S30_MONITOR_ENV=/opt/lingxi/monitoring/db-business.env
# 数据目录所在盘余量门槛（GB，缺省 10）
LINGXI_S30_MIN_FREE_GB=10
# public 处置：toc（缺省；drop 形实测会丢 initdb 给 public 的缺省 ACL，verify 判红）
LINGXI_S30_PUBLIC_MODE=toc
# 本地库参数覆盖（写进 compose.env 的 LINGXI_DB_<NAME>）；两项 idle 超时按来源实读值显式钉死（#859 实读 source=default 0）
# LINGXI_S30_DBVAR_MEMORY_LIMIT=768M
LINGXI_S30_DBVAR_IDLE_IN_TRANSACTION_TIMEOUT=0
LINGXI_S30_DBVAR_IDLE_SESSION_TIMEOUT=0
# locale / ICU 参数由 preflight 实读来源后自动派生进 compose.env，不在此设。
#
# 来源切换（仅预发 #896 用）：来源托管库不可读时，把保底导出装进一个临时替身库，再让脚本从替身库读：
# LINGXI_S30_SOURCE_ENV_FILE=<0600 文件，内容只有一行 LINGXI_MIGRATION_DSN=<替身库连接串>>
# 不设 = 读 <config_root>/.env.<后缀>.migrate（生产实跑形）。
