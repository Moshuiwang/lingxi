[Unit]
Description=Lingxi 资源层监控单轮采样（S-RC20-410，Issue #410）
# 形态照抄 lingxi-host-monitor.timer/.service 的既有先例（root 级 systemd timer/
# service，语义与 crontab 等效——biai-stage 宿主没有 cronie）；该单元 rc25 起也已
# 入库，见同目录 lingxi-host-monitor.{service,timer}。

[Service]
Type=oneshot
# User= 不写在本文件里，由 /etc/systemd/system/<单元名>.service.d/10-local.conf 提供
# （见同目录 10-local.conf.example）：stage 与生产的部署用户不同名，硬编码任何一个都会
# 让另一台在安装时被人工改写——2026-09-02 实测两台已因此分叉（报告 R6-D6）。
WorkingDirectory=/opt/lingxi/scripts/monitoring
# resource_sample.sh 调 _resource_sample.py 用的解释器从这里注入，不从 PATH 取 python3：
# 预发默认 python3 是 3.9，采样实现要求 3.11 以上，2026-09-15 预发实读每分钟失败 80 分钟
# 无人察觉。值与 host-monitor / release-pull 的 ExecStart 是同一个注入点（引导安装用
# <PYTHON_ABSOLUTE_PATH> 建的固定符号链接），见 deploy/监控告警.md「安装」的「Python 注入点」。
Environment=LINGXI_PYTHON=/opt/lingxi/bin/python3
ExecStart=/usr/bin/env bash /opt/lingxi/scripts/monitoring/resource_sample.sh
# 只依赖 docker（宿主 docker 组权限）与 Python 标准库，不需要任何凭据文件
# ——resource_sample.sh 不采集数据库/业务层，见 deploy/监控告警.md 分层清单。
TimeoutStartSec=30
