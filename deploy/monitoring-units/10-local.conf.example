# 本机 drop-in 样例：安装到
#   /etc/systemd/system/<单元名>.service.d/10-local.conf
# 每台机器各写一份，**不入库**（值随机器变）。
#
# 为什么 `User=` 只能住在这里（rc25 S-5，报告 R6-D6）：仓库单元此前硬编码
# `User=wangzhipeng`（stage 部署用户），而 2026-09-02 只读回读实测，`biplus-prod`
# 上实际装着的三个单元是 `User=bi-ai-deploy`——仓库文件与生产实体已经分叉，靠
# 安装时人工改写维持。把 `User=` 移进 drop-in 之后，仓库那份单元在两台机器上逐字
# 相同，`systemctl cat <单元>` 的差异只出现在这一段，一眼可见。
#
# 用法（以 host-monitor 为例，其余单元同构）：
#   sudo install -d -m 755 /etc/systemd/system/lingxi-host-monitor.service.d
#   sudo install -m 644 /dev/null /etc/systemd/system/lingxi-host-monitor.service.d/10-local.conf
#   sudo tee ... < 本文件内容，把 <部署用户> 换成该机器的部署用户
#   sudo systemctl daemon-reload
#
# 缺这份 drop-in 时单元会以 root 运行（systemd 默认）——装之前务必先确认它存在，
# 见 deploy/监控告警.md「安装」的核对步骤。

[Service]
User=<部署用户>
